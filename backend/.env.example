DATABASE_URL=postgresql+psycopg://fixtrack:fixtrack@localhost:5432/fixtrack
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional. Generate a separate random value for first-admin browser setup.
# SETUP_TOKEN=
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_MINUTES=30
# Optional: enables administrator-triggered AI estimate suggestions.
# Keep this key on the backend; never use a VITE_ prefix or commit it.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=30
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Intake requests allow one retry, with a fixed 15-second timeout per attempt.
TRIAGE_REQUESTS_PER_MINUTE=5
